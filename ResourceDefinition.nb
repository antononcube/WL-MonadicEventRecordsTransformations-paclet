Cell["\<\
Here is a monad pipeline that process the event records into sparse matrices:\
\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.970408356202544*^9, 3.970408387466013*^9}},
 CellID->1722006928,ExpressionUUID->"84892116-5461-4b01-bc91-f4284fc9abaf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"p2", "=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ERTMonUnit", "[", "]"}], "\[DoubleLongRightArrow]", 
    "\[IndentingNewLine]", 
    RowBox[{"ERTMonSetEventRecords", "[", "eventRecords", "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", 
    RowBox[{"ERTMonSetEntityAttributes", "[", "entityAttributes", "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", "ERTMonEchoDataSummary", "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", 
    RowBox[{"ERTMonSetComputationSpecification", "[", "compSpec", "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", "ERTMonGroupEntityVariableRecords", "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", 
    RowBox[{"ERTMonComputeVariableStatistic", "[", "Histogram", "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", 
    RowBox[{
    "ERTMonEchoFunctionValue", "[", "\"\<Variable distributions:\>\"", "]"}], 
    "\[DoubleLongRightArrow]", "\[IndentingNewLine]", 
    "ERTMonFindVariableOutlierBoundaries", "\[DoubleLongRightArrow]", 
    "\[IndentingNewLine]", 
    RowBox[{
    "ERTMonEchoFunctionValue", "[", "\"\<Outlier boundaries:\>\"", "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", 
    RowBox[{
    "ERTMonEntityVariableGroupsToTimeSeries", "[", "\"\<MaxTime\>\"", "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", "ERTMonAggregateTimeSeries", "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", "ERTMonMakeContingencyMatrices", "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", 
    RowBox[{"ERTMonEchoFunctionValue", "[", 
     RowBox[{"\"\<Contingency matrices:\>\"", ",", 
      RowBox[{
       RowBox[{"MatrixPlot", "/@", "#"}], "&"}]}], "]"}]}]}], ";"}]], "Input",
 
