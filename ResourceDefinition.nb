\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.747146585213808*^9, 3.7471466310245123`*^9}, 
   3.7473526530987387`*^9},
 CellID->1276715167,ExpressionUUID->"54efa937-b40f-42bf-afa9-4769e09e5ac3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"srecs", "=", 
   RowBox[{"eventRecords", "[", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"#Variable", "\[Equal]", "\"\<Temperature\>\""}], "&"}], "]"}], 
    "]"}]}], ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.747146427938943*^9, 3.7471464724318743`*^9}, {
  3.747146634591147*^9, 3.747146695152359*^9}, {3.747146736631509*^9, 
  3.7471467553162117`*^9}, {3.747147143020939*^9, 3.747147166947111*^9}, {
  3.970406288896038*^9, 3.970406289288216*^9}},
 CellLabel->"In[9]:=",
 CellID->95210945,ExpressionUUID->"bf92ccca-cebc-424b-a2fe-043f2fa07f2c"],

Cell["\<\
And here plot the corresponding time series obtained by grouping the records \
by station (entity ID's) and taking the columns \"ObservationTime\" and \
\"Value\":\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.7471467005501823`*^9, 3.747146710926263*^9}, {
  3.747146966156023*^9, 3.747147050181869*^9}, {3.747352654928679*^9, 
  3.747352655344996*^9}},
 CellID->335035600,ExpressionUUID->"84766e8f-7cc4-4574-826d-38291c9c2ef6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grecs", "=", 
   RowBox[{"Normal", "@", 
    RowBox[{
     RowBox[{"GroupBy", "[", 
      RowBox[{"srecs", ",", 
       RowBox[{"#EntityID", "&"}]}], "]"}], "[", 
     RowBox[{"All", ",", "All", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<ObservationTime\>\"", ",", "\"\<Value\>\""}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"DateListPlot", "[", 
  RowBox[{"grecs", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["4", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            
            TagBox["632", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    ImageSize -> Large, PlotTheme -> "Detailed", AspectRatio -> 1/3, 
     FrameLabel -> {"Time", "Temperature, C\[Degree]"}],
    SelectWithContents->True,
    Selectable->False]}], "]"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.747146748746331*^9, 3.747146761246825*^9}, {
   3.747146818164315*^9, 3.747146846647756*^9}, 3.7471469620387163`*^9, {
