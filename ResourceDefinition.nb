Cell[BoxData[{
 RowBox[{
  RowBox[{"citiesSpec", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<London\>\"", ",", "\"\<UK\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Melbourne\>\"", ",", "\"\<Australia\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Sydney\>\"", ",", "\"\<Australia\>\""}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dateRange", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2024", ",", "10", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2025", ",", "10", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wProps", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Temperature\>\"", ",", "\"\<MaxTemperature\>\"", 
     ",", "\"\<Pressure\>\"", ",", "\"\<Humidity\>\"", 
     ",", "\"\<WindSpeed\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"res", "=", 
   RowBox[{"WeatherEventRecords", "[", 
    RowBox[{"citiesSpec", ",", "dateRange", ",", "wProps", ",", "1"}], 
    "]"}]}], ";"}]}], "Input",
 TaggingRules->{},
