Cell["\<\
A software monad for the parameterized transformation of event records with \
different variables and entities into (manageable) time series and sparse \
matrices.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{
  3.970413979910614*^9, {3.9704147735993233`*^9, 3.970414816900242*^9}, 
   3.970415515670993*^9, {3.970429769451852*^9, 3.9704297713968773`*^9}, {
   3.9710099650751667`*^9, 3.971009977404167*^9}},
 CellTags->"DefaultContent",
 CellID->312061637,ExpressionUUID->"3c084a4b-fa58-4c82-9962-3c14d0db1075"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Details",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Details", 
     Cell[
      BoxData[
       FrameBox[
