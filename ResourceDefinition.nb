Cell[TextData[{
 "Prepare events data using weather data from meteorological stations close \
to certain major cities. The weather data is retrieved with paclet's function \
",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["WeatherEventRecords", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->
     "paclet:AntonAntonov/MonadicEventRecordsTransformations/ref/\
WeatherEventRecords",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "15bf6eb6-5ad9-42bc-9a86-aacd455d445c"],
 " from the paclet:"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.970402591765709*^9, 3.9704026466901503`*^9}, {
   3.9704030460842323`*^9, 3.97040304866509*^9}, {3.9704149111242723`*^9, 
   3.970414930157713*^9}, 3.970415524955249*^9},
 CellID->317347410,ExpressionUUID->"4e151f54-08a4-4918-9e85-2c150f3ef5e5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"citiesSpec", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Miami\>\"", ",", "\"\<USA\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Jacksonville\>\"", ",", "\"\<USA\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Chicago\>\"", ",", "\"\<USA\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<London\>\"", ",", "\"\<UK\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Melbourne\>\"", ",", "\"\<Australia\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Sydney\>\"", ",", "\"\<Australia\>\""}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dateRange", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2024", ",", "10", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2025", ",", "10", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wProps", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Temperature\>\"", ",", "\"\<MaxTemperature\>\"", 
     ",", "\"\<Pressure\>\"", ",", "\"\<Humidity\>\"", 
     ",", "\"\<WindSpeed\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"res", "=", 
   RowBox[{"WeatherEventRecords", "[", 
    RowBox[{"citiesSpec", ",", "dateRange", ",", "wProps", ",", "0"}], 
    "]"}]}], ";"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.747145784253087*^9, 3.7471457995301237`*^9}, 
   3.747145840614731*^9, {3.747147101597167*^9, 3.7471471093016*^9}, {
   3.747234261263218*^9, 3.747234265824278*^9}, {3.7472343073185797`*^9, 
   3.747234307789476*^9}, 3.747234343596394*^9, {3.9704055514489098`*^9, 
   3.9704055781826363`*^9}, {3.970405783085253*^9, 3.970405835828001*^9}, {
   3.970405915327533*^9, 3.9704059290394382`*^9}, {3.9704059709222317`*^9, 
   3.970406020077114*^9}, {3.970406050600502*^9, 3.970406095125144*^9}, {
   3.970430132233081*^9, 3.9704301425934153`*^9}},
 CellLabel->"In[1]:=",
 CellID->1006733200,ExpressionUUID->"80d5ae4b-af79-41c2-80bf-590a83b986fd"],

