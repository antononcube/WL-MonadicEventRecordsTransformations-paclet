 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "LongDescription"},
 DefaultNewCellStyle->"Text",
 CellTags->{"Basic Description", "LongDescription", "TemplateCellGroup"},
 CellID->97826971,ExpressionUUID->"cb733161-9bf4-4bc7-b6cf-f73bcd516823"],

Cell["\<\
A software monad for transformation of event records with different variables \
and entities into (manageable) time series and sparse matrices.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{
  3.970413979910614*^9, {3.9704147735993233`*^9, 3.970414816900242*^9}, 
   3.970415515670993*^9, {3.970429769451852*^9, 3.9704297713968773`*^9}},
 CellTags->"DefaultContent",
 CellID->312061637,ExpressionUUID->"3c084a4b-fa58-4c82-9962-3c14d0db1075"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Details",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Details", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "Details may include a long description of the resource's contents, \
history, methodology or other relevant information. Give references here if \
they are directly relevant to the resource. The details will appear above the \
examples on the webpage for the resource.", "MoreInfoText"], Background -> 
        GrayLevel[0.95], FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], 
        RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoDetails"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "4fc86076-326e-48d6-a185-d7c9a6dabd42"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "Details"},
 DefaultNewCellStyle->"Notes",
 CellTags->{"Details", "TemplateCellGroup"},
 CellID->280804237,ExpressionUUID->"d54039df-7cb7-449f-9bee-40472c097bbf"],

Cell["\<\
The primary goal of this Event Records Transformations Monad (ERTMon) is to \
convert hetergenous events data into sparse matrices (suitable for use in \
machine learning and statistical algorithms.)\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.970414366230875*^9, 3.970414472686574*^9}, {
  3.970429790911783*^9, 3.970429796401363*^9}, {3.970479450132317*^9, 
  3.970479479130608*^9}},
 CellTags->"DefaultContent",
 CellID->741278932,ExpressionUUID->"e718b1ee-1f46-4a22-8d3e-57985a0b139f"],

Cell[TextData[{
 "The produced sparse matrices are with named rows and columns -- see ",
 ButtonBox["\"AntonAntonov/SSparseMatrix\"",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
AntonAntonov/SSparseMatrix/"], None},
  ButtonNote->
   "https://resources.wolframcloud.com/PacletRepository/resources/\
AntonAntonov/SSparseMatrix/"],
 "."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.970479483458852*^9, 3.97047954317714*^9}},
 CellID->569689698,ExpressionUUID->"1e4caacc-ff95-4970-965c-0f8c9f1e604d"],

Cell["The monad takes a computational specification dataset.", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.970429797875255*^9, 3.97042982553259*^9}, {
  3.970479555826036*^9, 3.970479587626499*^9}},
 CellID->1640956422,ExpressionUUID->"692414e3-aaf3-4d8f-abac-97ff27ca3172"],

Cell["\<\
The event data records are grouped by entity identifier and variable.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.970429827483266*^9, 3.97042989853857*^9}},
 CellID->1574568833,ExpressionUUID->"26fbde58-8af6-4166-8fee-dc94352f1169"],

Cell["\<\
Groups corresponding to the same variable are used to make a sparse matrix \
corresponding to that variable.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.970429902216599*^9, 3.970429946044858*^9}},
 CellID->183314948,ExpressionUUID->"a6cf6ff6-b71b-40a8-938d-edee6f711156"],

Cell["\<\
In the obtained variable sparse matrices each rows corresponds to an entitity \
identifier.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.970429948568283*^9, 3.9704299780568323`*^9}},
 CellID->1944373284,ExpressionUUID->"92ad53fe-b546-40ba-a42f-07d348217beb"],

Cell["\<\
The matrices are normalized according to the computational specification.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.970429980440398*^9, 3.9704300133508453`*^9}},
 CellID->416729343,ExpressionUUID->"2511c4e7-45b9-4751-8b17-c6eb6d1abb20"],

Cell["\<\
A normalization can be \"global\" across all entities for a given variable, \
or \"local\", separately computed for each matrix row.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.970430015228676*^9, 3.970430105979266*^9}, {
  3.970479437924952*^9, 3.970479438688694*^9}},
 CellID->1602427168,ExpressionUUID->"83ae2c29-d4c6-4db8-a086-a0a6134a9380"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Primary Context",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"PrimaryContext", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
         TextData[{
          "Specify the primary context of your paclet that users should load \
with ", 
           Cell[
            BoxData[
             StyleBox[
              TagBox[
               ButtonBox[
                StyleBox[
                "Needs", "SymbolsRefLink", ShowStringCharacters -> True, 
                 FontFamily -> "Source Sans Pro"], BaseStyle -> Dynamic[
                  FEPrivate`If[
                   CurrentValue["MouseOver"], {
                   "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {
                   "Link"}]], ButtonData -> "paclet:ref/Needs", 
                ContentPadding -> False], 
               MouseAppearanceTag["LinkHand"]], ShowStringCharacters -> True, 
              FontFamily -> "Source Sans Pro"]]], " or ", 
           Cell[
            BoxData[
             StyleBox[
              TagBox[
