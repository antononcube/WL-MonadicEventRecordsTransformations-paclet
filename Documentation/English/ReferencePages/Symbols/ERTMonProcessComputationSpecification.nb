Cell["\<\
Assign max history length to be 3 weeks and aggregation interval to be 4 \
hours:\
\>", "ExampleText",
 CellChangeTimes->{{3.9710097133559637`*^9, 3.971009753255239*^9}},
 CellID->947667398,ExpressionUUID->"179b0228-30f0-48a0-8087-803ff4f7d724"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"maxHistoryLength", ",", "aggIntervalLength"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"3600", "*", "24", "*", "7", "*", "3"}], ",", 
     RowBox[{"4", "*", "3600"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.971009674011922*^9, 3.971009710955717*^9}, 
