            "\[Rule]", "\"\<Entity\>\""}], ",", 
           
           RowBox[{"\"\<NormalizationFunction\>\"", 
            "\[Rule]", "\"\<Mean\>\""}]}], "|>"}]}], "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Temperature\>\"", ",", "\"\<Heartbeat\>\"", 
        ",", "\"\<RespiratoryRate\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Mean\>\"", ",", "\"\<Range\>\""}], "}"}]}], "]"}]}]}], 
