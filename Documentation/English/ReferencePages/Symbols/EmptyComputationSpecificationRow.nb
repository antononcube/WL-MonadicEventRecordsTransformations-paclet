           RowBox[{"\"\<AggregationIntervalLength\>\"", "\[Rule]", 
            "aggIntervalLength"}], ",", 
           RowBox[{"\"\<AggregationFunction\>\"", "\[Rule]", "#2"}], ",", 
           
