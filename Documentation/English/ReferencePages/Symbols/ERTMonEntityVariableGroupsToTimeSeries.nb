Notebook[{

Cell[CellGroupData[{
Cell["ERTMonEntityVariableGroupsToTimeSeries", "ObjectName",
 CellID->1834312081,ExpressionUUID->"8509560e-54bd-41e9-ae29-d5355c41f3ea"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6f07f180-508b-45b2-b148-26a65cfaeb8f"],
 "Converts the groups of entity-variable records into time series and aligns \
them according to the argument (a time point.) The derived time series are \
stored in the context under the key \"timeSeries\"."
}], "Usage",
 CellID->7909035,ExpressionUUID->"6a5fc4cc-f808-44df-9c63-bb5c26b86390"],

