Cell["\<\
Note that the result is given as a pipeline value, the value of the context \
key \[CloseCurlyDoubleQuote]timeSeries\[CloseCurlyDoubleQuote] is not changed.\
\>", "Text",
 CellChangeTimes->{{3.747585739510228*^9, 3.7475857711789417`*^9}, 
   3.7475988385726423`*^9},
 CellID->846980849,ExpressionUUID->"825bed45-28c8-40dc-bb58-7eb38b0c29c9"],

Cell["\<\
(In the future, the computation specification and its handling might be \
extended to handle moving average or other time series function \
specifications.)\
\>", "Text",
 CellChangeTimes->{{3.747653542007394*^9, 3.747653544400292*^9}},
 CellID->1685516827,ExpressionUUID->"8697fd0c-c8b4-4e11-90f8-dccb222143a5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Normalization", "Subsection",
 CellChangeTimes->{{3.747234828576994*^9, 3.747234830872594*^9}},
 CellID->1024523812,ExpressionUUID->"1682ba63-77e3-4530-ad98-9c5c7602898d"],

Cell["\<\
With \[OpenCurlyDoubleQuote]normalization\[CloseCurlyDoubleQuote] we mean \
that the values of a given time series values are divided (normalized) with a \
descriptive statistic derived from a specified set of values. The specified \
set of values is given with the parameter \
\[OpenCurlyDoubleQuote]NormalizationScope\[CloseCurlyDoubleQuote] in \
computation specification.\
\>", "Text",
 CellChangeTimes->{{3.74734971556863*^9, 3.747349909788679*^9}},
 CellID->647826638,ExpressionUUID->"189b05be-c8b1-4e41-b68d-483b2b5fc1e9"],

Cell["\<\
At the normalization stage each time series is associated with an entity ID \
and variable.\
\>", "Text",
 CellChangeTimes->{3.747350327958836*^9},
 CellID->280214576,ExpressionUUID->"f0ea9c51-7367-4d58-acaa-3fc12517d61b"],

Cell["\<\
Normalization is done at three different scopes: \
\[OpenCurlyDoubleQuote]entity\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]attribute\[CloseCurlyDoubleQuote], and \
\[OpenCurlyDoubleQuote]variable\[CloseCurlyDoubleQuote].  \
\>", "Text",
 CellChangeTimes->{{3.7473494968323803`*^9, 3.7473495602478027`*^9}, {
  3.7473497016279907`*^9, 3.747349702572948*^9}, {3.747349967108234*^9, 
  3.747349974364523*^9}, {3.7473501716352*^9, 3.7473502040650043`*^9}, {
  3.747350290076388*^9, 3.747350303930676*^9}, {3.747350709760331*^9, 
  3.747350710245048*^9}, {3.747350971640335*^9, 3.747350974455009*^9}},
 CellID->134740961,ExpressionUUID->"ea1784e7-479c-47b9-a9ed-f83eda31cfbe"],

Cell[TextData[{
 "Given a time series ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "(", 
    RowBox[{"i", ",", 
     StyleBox["var",
      FontSlant->"Italic"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "20a760b1-e69a-44bb-b514-6986a4d418ce"],
 " corresponding to entity ID ",
 Cell[BoxData[
  FormBox[
   StyleBox["i",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "c384cde0-c395-49db-8923-585724c4da21"],
 " and a variable ",
 Cell[BoxData[
  FormBox[
   StyleBox["var",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "938e2c5c-af99-45d6-a759-9bfa107281a4"],
 " we define the normalization values for the different scopes in the \
following ways."
}], "Text",
 CellChangeTimes->{{3.7473494968323803`*^9, 3.7473495602478027`*^9}, {
  3.7473497016279907`*^9, 3.747349702572948*^9}, {3.747349967108234*^9, 
  3.747349974364523*^9}, {3.7473501716352*^9, 3.7473502040650043`*^9}, {
  3.747350290076388*^9, 3.74735042901497*^9}, {3.747350462802339*^9, 
  3.747350507675411*^9}, {3.7473505920285673`*^9, 3.74735059223181*^9}, {
  3.74735062743293*^9, 3.747350635581574*^9}},
 CellID->1143567589,ExpressionUUID->"6a14e5b8-11e3-4102-9016-fb6b136be79e"],

Cell[TextData[{
 "Normalization with scope \[OpenCurlyDoubleQuote]entity\
\[CloseCurlyDoubleQuote] means that the descriptive statistic is derived from \
the values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "(", 
    RowBox[{"i", ",", 
     StyleBox["var",
      FontSlant->"Italic"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "8226af3e-e19c-4b1a-b880-8998b39489ec"],
 " only."
}], "Item",
 CellChangeTimes->{{3.747349566930368*^9, 3.747349658187718*^9}, {
   3.7473499253719387`*^9, 3.747349964351926*^9}, {3.747350105301193*^9, 
   3.747350130966879*^9}, 3.747350441669685*^9, {3.747350519983797*^9, 
   3.747350526068551*^9}, {3.747350638198215*^9, 3.747350641093526*^9}},
 CellID->2109311320,ExpressionUUID->"5edf8586-d0c4-40b3-88f0-bdf648083dd2"],

Cell["Normalization with scope attribute means that ", "Item",
 CellChangeTimes->{{3.747349566930368*^9, 3.747349697275095*^9}, {
  3.7473500491092567`*^9, 3.747350098532633*^9}, {3.747350575467716*^9, 
  3.7473505761211*^9}, {3.747350612355109*^9, 3.747350622833807*^9}, {
  3.7473506656713867`*^9, 3.747350808650343*^9}},
 CellID->535310564,ExpressionUUID->"195bb4c3-6935-4cab-b7df-b9b33690b207"],

Cell[TextData[{
 "from the entity attributes dataset we find attribute value that corresponds \
to ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "d1299951-cd7f-4c5b-9a2c-a091dd6d5777"],
 ", "
}], "Subitem",
 CellChangeTimes->{{3.747349566930368*^9, 3.747349697275095*^9}, {
  3.7473500491092567`*^9, 3.747350098532633*^9}, {3.747350575467716*^9, 
  3.7473505761211*^9}, {3.747350612355109*^9, 3.747350622833807*^9}, {
  3.7473506656713867`*^9, 3.7473508131163683`*^9}},
 CellID->1155651865,ExpressionUUID->"d6d81ecc-f4a7-4c8d-b49a-f3344fe967ba"],

Cell["\<\
next we find all entity ID's that are associated with the same attribute \
value,\
\>", "Subitem",
 CellChangeTimes->{{3.747349566930368*^9, 3.747349697275095*^9}, {
  3.7473500491092567`*^9, 3.747350098532633*^9}, {3.747350575467716*^9, 
  3.7473505761211*^9}, {3.747350612355109*^9, 3.747350622833807*^9}, {
  3.7473506656713867`*^9, 3.747350823915346*^9}},
 CellID->1198791587,ExpressionUUID->"adbddfcc-d875-4f6a-99ab-0585f4b07d88"],

Cell[TextData[{
 "next we find value of normalization descriptive statistic using the time \
series that correspond to the variable ",
 Cell[BoxData[
  FormBox[
   StyleBox["var",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "dc0a13eb-580e-4bbe-99d6-26e581007b8d"],
 " and the entity ID\[CloseCurlyQuote]s found in the previous step."
}], "Subitem",
 CellChangeTimes->{{3.747349566930368*^9, 3.747349697275095*^9}, {
  3.7473500491092567`*^9, 3.747350098532633*^9}, {3.747350575467716*^9, 
  3.7473505761211*^9}, {3.747350612355109*^9, 3.747350622833807*^9}, {
  3.7473506656713867`*^9, 3.747350922051811*^9}},
 CellID->398626555,ExpressionUUID->"11d1d7be-0a1f-425b-ba00-a5c36d0ff9e8"],

Cell[TextData[{
 "Normalization with scope \[CloseCurlyDoubleQuote]variable\
\[CloseCurlyDoubleQuote] means that the descriptive statistic is derived from \
the values of all time series corresponding to ",
 Cell[BoxData[
  FormBox[
   StyleBox["var",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "a7910e55-d7bf-4b15-af79-346ed12f8eea"],
 "."
}], "Item",
 CellChangeTimes->{{3.747349566930368*^9, 3.747349658187718*^9}, {
  3.7473499253719387`*^9, 3.747349964351926*^9}, {3.747350106059087*^9, 
  3.747350166370184*^9}, {3.7473502789741983`*^9, 3.747350285610797*^9}, {
  3.7473505367570133`*^9, 3.747350559009042*^9}, {3.747350643677806*^9, 
  3.747350643815853*^9}},
 CellID->1715014892,ExpressionUUID->"99480d72-b9d2-49f3-a470-14201147cefd"],

Cell["\<\
Note that the scope \[OpenCurlyDoubleQuote]entity\[CloseCurlyDoubleQuote] is \
the most granular, and the scope \[OpenCurlyDoubleQuote]variable\
\[CloseCurlyDoubleQuote] is the coarsest.\
\>", "Text",
 CellChangeTimes->{{3.747350938679277*^9, 3.747350981912681*^9}},
 CellID->729779810,ExpressionUUID->"5b2be9bf-5d9f-43ce-8750-2bbad5983545"],

Cell[CellGroupData[{

Cell[TextData[{
 "The following command demonstrates the normalization effect -- compare the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "4ceaa569-77b8-459d-9d32-c30e489070e6"],
 "-axes scales of the time series corresponding to the same entity-variable \
pair."
}], "Text",
 CellChangeTimes->{{3.747598859521879*^9, 3.747598981224208*^9}},
 CellID->1130158653,ExpressionUUID->"8d64c4be-a128-41d8-9b3d-33152536d4d8"],

