Cell[TextData[{
 "The computation specification is set to the monad with the function ",
 StyleBox["ERTMonSetComputationSpecification", "Program"],
 "."
}], "Text",
 CellChangeTimes->{{3.747564420389793*^9, 3.7475644416185417`*^9}},
 CellID->268619231,ExpressionUUID->"fbe49b80-11bd-4c45-8f1e-f1d6ccf2fabe"],

Cell["\<\
Alternatively, a computation specification can be created and filled-in as a \
CSV file and read into the monad. (Not described here.)\
\>", "Text",
 CellChangeTimes->{
  3.747235576317636*^9, {3.747351005798408*^9, 3.7473510163605433`*^9}, {
   3.747563762088955*^9, 3.747563762302182*^9}, {3.7475644527788563`*^9, 
