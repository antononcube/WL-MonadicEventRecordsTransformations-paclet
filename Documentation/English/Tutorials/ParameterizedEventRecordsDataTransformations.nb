Cell[CellGroupData[{

Cell["Time series restriction and aggregation.", "Subsection",
 CellChangeTimes->{{3.747234834786462*^9, 3.747234839815364*^9}, {
  3.747234890238907*^9, 3.747234905888069*^9}, {3.7475774096977453`*^9, 
  3.7475774500608597`*^9}, {3.7475987169530373`*^9, 3.7475987200754747`*^9}},
 CellID->567242519,ExpressionUUID->"f116be26-39d0-4b69-8753-4590a8888312"],

Cell[TextData[{
 "The main goal of ",
 StyleBox["ERTMon", "Program"],
 " is to convert a diverse, general collection of event records into a \
collection of aligned time series over specified regular time grids."
}], "Text",
 CellChangeTimes->{{3.747577464351976*^9, 3.747577562798904*^9}},
 CellID->965107800,ExpressionUUID->"71b80fbf-5d63-4e8b-ba1c-2e15394be615"],

Cell[CellGroupData[{

Cell["\<\
The regular time grids are specified with the columns \
\[OpenCurlyDoubleQuote]MaxHistoryLength\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]AggregationIntervalLength\[CloseCurlyDoubleQuote] of \
the computation specification. The time series of the variables in the \
computation specification are restricted to the corresponding maximum history \
lengths and are aggregated using the corresponding aggregation lengths and \
functions. \
\>", "Text",
 CellChangeTimes->{{3.747577565048972*^9, 3.747577580765461*^9}, {
  3.747577645428032*^9, 3.7475776589536858`*^9}, {3.7475777772499037`*^9, 
  3.747577800783558*^9}, {3.747577853062916*^9, 3.747577914871244*^9}, {
  3.74757794820566*^9, 3.747577955956664*^9}, {3.747598741304494*^9, 
  3.747598784167336*^9}},
 CellID->622808809,ExpressionUUID->"33f7cd3a-22ab-44d9-9545-dec7d49d9394"],

