Cell[CellGroupData[{

Cell[TextData[{
 "The constructed rows are assembled into a dataset (with ",
 StyleBox["Dataset", "Program"],
 "). The function ",
 StyleBox["ProcessComputationSpecification", "Program"],
 " is used to convert a user-made specification dataset into a form used by \
",
 StyleBox["ERTMon", "Program"],
 "."
}], "Text",
