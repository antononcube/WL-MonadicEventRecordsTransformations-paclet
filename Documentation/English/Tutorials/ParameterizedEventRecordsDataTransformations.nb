}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"compSpecRows", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"EmptyComputationSpecificationRow", "[", "]"}], ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Variable\>\"", "\[Rule]", "#"}], ",", 
         RowBox[{"\"\<MaxHistoryLength\>\"", "\[Rule]", 
          RowBox[{"60", "*", "24", "*", "3600"}]}], ",", 
         RowBox[{"\"\<AggregationIntervalLength\>\"", "\[Rule]", 
          RowBox[{"2", "*", "24", "*", "3600"}]}], ",", 
         RowBox[{"\"\<AggregationFunction\>\"", "\[Rule]", "\"\<Mean\>\""}], ",", 
         RowBox[{"\"\<NormalizationScope\>\"", "\[Rule]", "\"\<Entity\>\""}], 
         ",", 
         RowBox[{"\"\<NormalizationFunction\>\"", 
          "\[Rule]", "\"\<Mean\>\""}]}], "|>"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Union", "[", 
     RowBox[{"Normal", "[", 
      RowBox[{"eventRecords", "[", 
       RowBox[{"All", ",", "\"\<Variable\>\""}], "]"}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"compSpecRows", "=", "\[IndentingNewLine]", 
   RowBox[{"Join", "[", "\[IndentingNewLine]", 
    RowBox[{"compSpecRows", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"EmptyComputationSpecificationRow", "[", "]"}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Variable\>\"", "\[Rule]", "#"}], ",", 
           RowBox[{"\"\<MaxHistoryLength\>\"", "\[Rule]", 
            RowBox[{"60", "*", "24", "*", "3600"}]}], ",", 
           RowBox[{"\"\<AggregationIntervalLength\>\"", "\[Rule]", 
            RowBox[{"2", "*", "24", "*", "3600"}]}], ",", 
           
           RowBox[{"\"\<AggregationFunction\>\"", 
            "\[Rule]", "\"\<Range\>\""}], ",", 
           
           RowBox[{"\"\<NormalizationScope\>\"", 
            "\[Rule]", "\"\<Country\>\""}], ",", 
           
           RowBox[{"\"\<NormalizationFunction\>\"", 
            "\[Rule]", "\"\<Mean\>\""}]}], "|>"}]}], "]"}], "&"}], "/@", 
      RowBox[{"Union", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{"eventRecords", "[", 
         RowBox[{"All", ",", "\"\<Variable\>\""}], "]"}], "]"}], "]"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"EmptyComputationSpecificationRow", "[", "]"}], ",", 
         RowBox[{"<|", 
