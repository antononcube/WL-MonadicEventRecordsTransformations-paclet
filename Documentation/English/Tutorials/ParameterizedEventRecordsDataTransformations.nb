Cell[CellGroupData[{

Cell["Conversion of event records to time series", "Subsection",
 CellChangeTimes->{{3.7475756691587276`*^9, 3.7475756840411577`*^9}},
 CellID->1892283335,ExpressionUUID->"c2a6f79d-cffa-4fc3-a776-8edd56532046"],

Cell[CellGroupData[{

Cell[TextData[{
 "The grouped event records are converted into time series with the function ",
 StyleBox["ERTMonEntityVariableGroupsToTimeSeries", "Program"],
 ". The time series are aligned to a time point specification given as an \
argument. The argument can be: a date object, \[OpenCurlyDoubleQuote]MinTime\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]MaxTime\
\[CloseCurlyDoubleQuote], or \[OpenCurlyDoubleQuote]None\
\[CloseCurlyDoubleQuote]. (\[OpenCurlyDoubleQuote]MaxTime\
\[CloseCurlyDoubleQuote] is the default.)"
}], "Text",
 CellChangeTimes->{{3.747576088798008*^9, 3.747576128914906*^9}, {
  3.747577168740127*^9, 3.747577269789987*^9}, {3.7475986306851397`*^9, 
  3.747598692490299*^9}, {3.7476534958570843`*^9, 3.747653501278644*^9}},
 CellID->1520682922,ExpressionUUID->"4e9ebfb7-713d-4e6a-9ad8-c5290cb5383f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"p", "\[DoubleLongRightArrow]", "\[IndentingNewLine]", 
   RowBox[{
   "ERTMonEntityVariableGroupsToTimeSeries", "[", "\"\<MinTime\>\"", "]"}], "\[DoubleLongRightArrow]",
    "\[IndentingNewLine]", 
   RowBox[{"ERTMonEchoFunctionContext", "[", 
    RowBox[{
     RowBox[{"#timeSeries", "\[LeftDoubleBracket]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "3", ",", "5"}], "}"}], "\[RightDoubleBracket]"}], 
     "&"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.747576131843511*^9, 3.7475761680933228`*^9}, {
  3.7475763886711683`*^9, 3.747576402709523*^9}, {3.747576929283657*^9, 
