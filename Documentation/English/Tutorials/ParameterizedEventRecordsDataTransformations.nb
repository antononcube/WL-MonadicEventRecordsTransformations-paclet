Cell[CellGroupData[{

Cell["Design considerations", "Section",
 CellChangeTimes->{3.738932917650569*^9},
 CellID->14960847,ExpressionUUID->"6598aa4b-a9e7-4268-bbe0-a1411f25342b"],

Cell[CellGroupData[{

Cell["Workflow", "Subsection",
 CellChangeTimes->{{3.746399293583556*^9, 3.7463992965741043`*^9}},
 CellID->191368830,ExpressionUUID->"11b7521f-3c27-4a54-9423-3ec95bdcce03"],

Cell["\<\
The steps of the main event records transformations workflow addressed in \
this document follow.\
\>", "Text",
 CellChangeTimes->{{3.741977088638846*^9, 3.7419770918549137`*^9}, {
  3.7420564834283123`*^9, 3.742056484783223*^9}, {3.7463991128848867`*^9, 
  3.746399115548505*^9}, {3.747653070097748*^9, 3.747653073032413*^9}},
 CellID->1552906251,ExpressionUUID->"cfac24dd-0f8b-450d-bd0c-ccdb1e15d019"],

Cell[TextData[{
 "Ingest event records and entity attributes given in the ",
 ButtonBox["Star schema",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Star_schema"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Star_schema"],
 " style."
}], "ItemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.7472330993726997`*^9}, {
  3.747233470743965*^9, 3.7472334707598867`*^9}, {3.747352130631962*^9, 
  3.7473521310009203`*^9}},
 CellID->1326598566,ExpressionUUID->"b7cdbd23-fab2-444b-bb87-0f0a406ab507"],

Cell[CellGroupData[{

Cell["Ingest a computation specification.", "ItemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.7472330993726997`*^9}, {
  3.747233471790708*^9, 3.7472334862419653`*^9}, {3.747352137852983*^9, 
  3.7473521389656763`*^9}},
 CellID->966875608,ExpressionUUID->"02b5c1a6-1164-45f6-b218-b8f233ecc117"],

Cell["\<\
Specified are aggregation time intervals, aggregation functions, \
normalization types and functions.\
\>", "SubitemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.7472330993726997`*^9}, {
  3.747233471790708*^9, 3.7472335336784363`*^9}},
 CellID->269586807,ExpressionUUID->"5b051060-e2d1-41ed-bbb8-f0d6e14acab3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Group event records based on unique entity ID and variable pairs.\
\>", "ItemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233131565263*^9}, {
  3.747352156786861*^9, 3.747352175393661*^9}},
 CellID->1902453726,ExpressionUUID->"17148fbc-e669-4eb2-af35-415024d2724f"],

Cell["\<\
Additional filtering can be applied using the entity attributes.\
\>", "SubitemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233162942981*^9}, {
  3.7473521823593817`*^9, 3.747352183515111*^9}},
 CellID->655752699,ExpressionUUID->"52950140-c95d-462f-b57b-38935389df5f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["For each variable find descriptive statistics properties.", \
"ItemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233349738895*^9}, {
  3.7472334312342863`*^9, 3.747233432415114*^9}},
 CellID->349535689,ExpressionUUID->"d7278096-76ea-46c9-a5a2-fd7f50f25855"],

Cell[CellGroupData[{

Cell["This is to facilitate normalization procedures.", "SubitemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.7472333646221027`*^9}},
 CellID->1278550478,ExpressionUUID->"7135939c-9bec-446a-b578-0ff48307386e"],

Cell["Optionally, for each variable find outlier boundaries.", \
"SubitemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.7472333943560677`*^9}},
 CellID->876511864,ExpressionUUID->"cf57e62f-db4d-4256-9efd-bb6cd5070e56"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Align each group of records to start or finish at some specified point.\
\>", "ItemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233225818405*^9}},
 CellID->1944563475,ExpressionUUID->"a438fa30-5491-45d5-bdd7-ef16883f4b67"],

Cell["For each variable we want to impose a regular time grid.", \
"SubitemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233284577854*^9}, {
  3.747233416934866*^9, 3.747233416935605*^9}},
 CellID->1872184279,ExpressionUUID->"db741e61-950d-482e-8cc6-9976ebcb569c"]
}, Open  ]],

Cell["From each group of records produce a time series.", "ItemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233284577854*^9}, {
  3.747233419614448*^9, 3.747233466953697*^9}, {3.7472335488122873`*^9, 
  3.747233626547922*^9}, {3.747233723743041*^9, 3.747233723743546*^9}},
 CellID->870781309,ExpressionUUID->"ec54240b-0554-4327-b4da-2b37b7219494"],

Cell[CellGroupData[{

Cell["\<\
For each time series do prescribed aggregation and normalization.\
\>", "ItemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233284577854*^9}, {
  3.747233419614448*^9, 3.747233466953697*^9}, {3.7472335488122873`*^9, 
  3.747233626547922*^9}, {3.74723372476086*^9, 3.747233744438014*^9}},
 CellID->120406058,ExpressionUUID->"266ea1e2-497c-417d-bfb1-8803151c1780"],

Cell["\<\
The variable that corresponds to each group of records has at least one \
(possibly several) computation specifications.\
\>", "SubitemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233284577854*^9}, {
   3.747233419614448*^9, 3.747233466953697*^9}, {3.7472335488122873`*^9, 
   3.7472337029468193`*^9}, 3.747233757273858*^9, 3.7472337935330477`*^9},
 CellID->735021332,ExpressionUUID->"1cbd26aa-0c34-4fbc-91c3-e2025bde7046"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Make a contingency matrix for each time series obtained in the previous step.\
\
\>", "ItemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233284577854*^9}, {
  3.747233419614448*^9, 3.747233466953697*^9}, {3.7472335488122873`*^9, 
  3.747233690493775*^9}, {3.747233759208913*^9, 3.747233850483959*^9}, {
  3.747352253437723*^9, 3.747352253638206*^9}},
 CellID->1177589380,ExpressionUUID->"a8b83e85-f39a-4ef6-9206-55f847294878"],

Cell["\<\
The contingency matrices have entity ID\[CloseCurlyQuote]s as rows, and time \
intervals enumerating values of time intervals.\
\>", "SubitemNumbered",
 CellChangeTimes->{{3.747232995976843*^9, 3.747233284577854*^9}, {
  3.747233419614448*^9, 3.747233466953697*^9}, {3.7472335488122873`*^9, 
  3.747233690493775*^9}, {3.747233759208913*^9, 3.747233903446949*^9}},
 CellID->535418908,ExpressionUUID->"9d061018-b13c-4caf-a176-45f71a9586db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The following flow-chart corresponds to the list of steps above.\
\>", "Text",
 CellChangeTimes->{3.746399130463307*^9},
 CellID->829105826,ExpressionUUID->"665670e3-66a1-4fb5-89c4-6f2524e6e0ff"],

