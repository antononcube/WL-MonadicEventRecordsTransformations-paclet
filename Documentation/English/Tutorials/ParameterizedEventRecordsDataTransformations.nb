Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Variable\"\>", "\[Rule]", 
    RowBox[{"Missing", "[", "]"}]}], ",", 
   RowBox[{"\<\"Explanation\"\>", "\[Rule]", "\<\"\"\>"}], ",", 
   RowBox[{"\<\"MaxHistoryLength\"\>", "\[Rule]", "3600"}], ",", 
   RowBox[{"\<\"AggregationIntervalLength\"\>", "\[Rule]", "60"}], ",", 
   RowBox[{"\<\"AggregationFunction\"\>", "\[Rule]", "\<\"Mean\"\>"}], ",", 
   RowBox[{"\<\"NormalizationScope\"\>", "\[Rule]", "\<\"Entity\"\>"}], ",", 
   RowBox[{"\<\"NormalizationFunction\"\>", "\[Rule]", "\<\"None\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.747605999048193*^9, 3.7476533845405293`*^9, 
