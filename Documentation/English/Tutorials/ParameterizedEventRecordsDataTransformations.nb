Cell[CellGroupData[{

Cell["Application of time series functions", "Subsection",
 CellChangeTimes->{{3.747585405711915*^9, 3.747585418862728*^9}},
 CellID->1697263507,ExpressionUUID->"8b2c4bb8-71ce-4a4e-9e47-79be75ed19d0"],

Cell[CellGroupData[{

Cell["\<\
At this point we can apply time series modifying functions. An often used \
such function is moving average.\
\>", "Text",
 CellChangeTimes->{{3.7475854215825768`*^9, 3.747585440413975*^9}, {
  3.747585490906095*^9, 3.7475855216647873`*^9}, {3.747598812419656*^9, 
