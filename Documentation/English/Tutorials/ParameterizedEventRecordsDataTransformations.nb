Cell[CellGroupData[{

Cell[TextData[{
 "The data we use is weather data from meteorological stations close to \
certain major cities. We retrieve the data with the function ",
 StyleBox["WeatherEventRecords", "Program"],
 " from the package [AAp9]."
}], "Text",
 CellChangeTimes->{{3.7471456993932247`*^9, 3.74714577696132*^9}, {
