Cell[TextData[{
 "Further discussion of making and using ML classification workflows through \
the monad software design pattern can be found in [",
 ButtonBox["AA2",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://mathematicaforprediction.wordpress.com/2018/05/15/a-monad-\
for-classification-workflows/"], None},
  ButtonNote->
   "https://mathematicaforprediction.wordpress.com/2018/05/15/a-monad-for-\
classification-workflows/"],
 "]."
}], "Text",
 CellChangeTimes->{{3.747599771521762*^9, 3.747599879042571*^9}, {
  3.7476636464823217`*^9, 3.7476636465910387`*^9}},
 CellID->2052799962,ExpressionUUID->"f04e058b-5785-459c-ada6-9ad61b50a8c1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Event records data design", "Section",
 CellChangeTimes->{{3.746399299353253*^9, 3.746399336557445*^9}},
 CellID->988818995,ExpressionUUID->"4919cf75-dc8a-496f-b0b2-e4015a6110ae"],

Cell[TextData[{
 "The data is structured to follow the style of ",
 ButtonBox["Star schema",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Star_schema"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Star_schema"],
 ". We have event records dataset (table) and entity attributes dataset \
(table)."
}], "Text",
 CellChangeTimes->{{3.747146154390789*^9, 3.747146160195449*^9}, {
  3.747146201813307*^9, 3.747146217897633*^9}, {3.747146259106996*^9, 
  3.747146264147443*^9}, {3.747146303331378*^9, 3.7471463723171663`*^9}},
 CellID->1852388479,ExpressionUUID->"3fd8e584-d8ad-4c10-8820-6c42bbb240ec"],

Cell["\<\
The structure datasets (tables) proposed satisfy a wide range of modeling \
data requirements. (Medical and financial modeling included.)\
\>", "Text",
 CellChangeTimes->{{3.747147255639783*^9, 3.747147296975576*^9}},
 CellID->1022735994,ExpressionUUID->"952b4e08-35f7-405f-9b01-5e8a51c5d296"],

Cell[CellGroupData[{

Cell["Entity event data", "Subsection",
 CellChangeTimes->{{3.7471473569835587`*^9, 3.7471473615288677`*^9}},
 CellID->664740570,ExpressionUUID->"c542dce4-9320-4326-935a-3be3ba4eae24"],

Cell[CellGroupData[{

Cell["\<\
The entity event data has the columns \[OpenCurlyDoubleQuote]EntityID\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]LocationID\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]ObservationTime\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]Variable\
\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]Value\[CloseCurlyDoubleQuote].\
\>", "Text",
 CellChangeTimes->{{3.747147429503242*^9, 3.747147448143527*^9}, {
  3.7471474881760817`*^9, 3.747147509996622*^9}},
 CellID->1084828296,ExpressionUUID->"4c484b84-f5fb-43ef-b2a6-c6a57f712fc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RandomSample", "[", 
  RowBox[{"eventRecords", ",", "6"}], "]"}]], "Input",
 CellChangeTimes->{{3.747147450096781*^9, 3.747147462150125*^9}},
 CellLabel->"In[27]:=",
 CellID->573007842,ExpressionUUID->"48f66374-030b-42b2-933f-04aec7cc3e58"],

Cell[BoxData[
 TagBox[
  TagBox[
   DynamicModuleBox[{TypeSystem`NestedGrid`PackagePrivate`$state$$ = <|
    "InitialData" -> {<|
       "EntityID" -> "Jacksonville_USA", "LocationID" -> "Jacksonville", 
        "ObservationTime" -> 3940876800, "Variable" -> "WindSpeed", "Value" -> 
        4.82|>, <|
       "EntityID" -> "Miami_USA", "LocationID" -> "Miami", "ObservationTime" -> 
        3957379200, "Variable" -> "MaxTemperature", "Value" -> 28.89|>, <|
       "EntityID" -> "Sydney_Australia", "LocationID" -> "Sydney", 
        "ObservationTime" -> 3948048000, "Variable" -> "Temperature", "Value" -> 
        24.83|>, <|
       "EntityID" -> "London_UK", "LocationID" -> "London", "ObservationTime" -> 
        3937075200, "Variable" -> "Temperature", "Value" -> 12.78|>, <|
       "EntityID" -> "Jacksonville_USA", "LocationID" -> "Jacksonville", 
        "ObservationTime" -> 3949776000, "Variable" -> "MaxTemperature", 
        "Value" -> 25.61|>, <|
       "EntityID" -> "Miami_USA", "LocationID" -> "Miami", "ObservationTime" -> 
        3937766400, "Variable" -> "Humidity", "Value" -> 0.879|>}, 
     "AllowEmbedding" -> True, "InitialShape" -> 
     TypeSystem`PackageScope`HeaderShape[<|{All, "EntityID"} -> 
        1, {All, "LocationID"} -> 1, {All, "ObservationTime"} -> 
        1, {All, "Variable"} -> 1, {All, "Value"} -> 1|>, 
       TypeSystem`PackageScope`Limited[
        TypeSystem`PackageScope`ColumnShape[
         TypeSystem`PackageScope`Limited[
          
          TypeSystem`PackageScope`RowShape[<|
           "EntityID" -> TypeSystem`PackageScope`AtomShape[168.], 
            "LocationID" -> TypeSystem`PackageScope`AtomShape[126.], 
            "ObservationTime" -> TypeSystem`PackageScope`AtomShape[34], 
            "Variable" -> TypeSystem`PackageScope`AtomShape[147.], "Value" -> 
            TypeSystem`PackageScope`AtomShape[60]|>], 
          DirectedInfinity[1], 5, {All}]], 6, 
        DirectedInfinity[1], {}]], "InitialType" -> TypeSystem`Vector[
       TypeSystem`Struct[{
        "EntityID", "LocationID", "ObservationTime", "Variable", "Value"}, {
         TypeSystem`Atom[
          TypeSystem`Enumeration[
          "Jacksonville_USA", "London_UK", "Miami_USA", "Sydney_Australia"]], 
         
         TypeSystem`Atom[
          TypeSystem`Enumeration[
          "Jacksonville", "London", "Miami", "Sydney"]], 
         TypeSystem`Atom[Integer], 
         TypeSystem`Atom[
          TypeSystem`Enumeration[
          "Humidity", "MaxTemperature", "Temperature", "WindSpeed"]], 
         TypeSystem`Atom[Real]}], 6], "Meta" -> <||>, "RowTarget" -> 20, 
     "ColumnTarget" -> 10, "Shape" -> 
     TypeSystem`PackageScope`HeaderShape[<|{All, "EntityID"} -> 
        1, {All, "LocationID"} -> 1, {All, "ObservationTime"} -> 
        1, {All, "Variable"} -> 1, {All, "Value"} -> 1|>, 
       TypeSystem`PackageScope`Limited[
        TypeSystem`PackageScope`ColumnShape[
         TypeSystem`PackageScope`Limited[
          
          TypeSystem`PackageScope`RowShape[<|
           "EntityID" -> TypeSystem`PackageScope`AtomShape[168.], 
            "LocationID" -> TypeSystem`PackageScope`AtomShape[126.], 
            "ObservationTime" -> TypeSystem`PackageScope`AtomShape[34], 
            "Variable" -> TypeSystem`PackageScope`AtomShape[147.], "Value" -> 
            TypeSystem`PackageScope`AtomShape[60]|>], 
          DirectedInfinity[1], 5, {All}]], 6, 
        DirectedInfinity[1], {}]], "Type" -> TypeSystem`Vector[
       TypeSystem`Struct[{
        "EntityID", "LocationID", "ObservationTime", "Variable", "Value"}, {
         TypeSystem`Atom[
          TypeSystem`Enumeration[
          "Jacksonville_USA", "London_UK", "Miami_USA", "Sydney_Australia"]], 
         
         TypeSystem`Atom[
          TypeSystem`Enumeration[
          "Jacksonville", "London", "Miami", "Sydney"]], 
         TypeSystem`Atom[Integer], 
         TypeSystem`Atom[
          TypeSystem`Enumeration[
          "Humidity", "MaxTemperature", "Temperature", "WindSpeed"]], 
         TypeSystem`Atom[Real]}], 6], "Path" -> {}, "DisplayedRowCount" -> 6, 
     "DisplayedColumnCount" -> 5, "DataRowCount" -> 6, "DataColumnCount" -> 5,
      "SortPaths" -> {}, "SortDirections" -> {}, "HiddenItemsMap" -> Null, 
     "UpdateType" -> 1|>, TypeSystem`NestedGrid`PackagePrivate`$outputID$$, 
    TypeSystem`NestedGrid`PackagePrivate`$path$$ = {}, 
    TypeSystem`NestedGrid`PackagePrivate`$vPos$$ = 1, 
    TypeSystem`NestedGrid`PackagePrivate`$hPos$$ = 1, 
    TypeSystem`NestedGrid`PackagePrivate`$grid$$ = 
    DynamicModule[{
     TypeSystem`NestedGrid`PackagePrivate`renderedGrid = Deploy[
        Style[
         Grid[{{
            Item[
             Pane[
              Annotation[
               EventHandler[
                MouseAppearance[
                 Mouseover["EntityID", 
                  Style[
                  "EntityID", FontColor -> 
                   RGBColor[
                    0.2749633796890805, 0.536987306253161, 
                    0.791992189065661]]], "LinkHand"], {"MouseClicked", 1} :> 
                If[
                  TypeSystem`NestedGrid`PackagePrivate`checkInteractivity[
                  TypeSystem`NestedGrid`PackagePrivate`$state$$], 
                  TypeSystem`NestedGrid`PackagePrivate`updateState[
                  TypeSystem`NestedGrid`PackagePrivate`$state$$, 
                   TypeSystem`NestedGrid`PackagePrivate`$path$$, 
                   TypeSystem`NestedGrid`PackagePrivate`$vPos$$, 
                   TypeSystem`NestedGrid`PackagePrivate`$hPos$$, 
                   TypeSystem`NestedGrid`PackagePrivate`$grid$$, 
                   TypeSystem`NestedGrid`PackagePrivate`localHold[
                    TypeSystem`NestedGrid`PackagePrivate`localHold[
                    TypeSystem`NestedGrid`PackagePrivate`$outputID$$]]][{
                   All, "EntityID"}, 1]]], 
               TypeSystem`NestedGrid`PackagePrivate`$SliceMarker[
                TypeSystem`NestedGrid`PackagePrivate`localHold[
                TypeSystem`NestedGrid`PackagePrivate`$outputID$$]][{
                All, "EntityID"}, "ColumnHeader", True], "Mouse"], 
              ImageSize -> {{1, Full}, Automatic}, 
              ImageMargins -> {{5, 3}, {4, 5}}], Background -> 
             RGBColor[
              0.9500473017990948, 0.9500473017990948, 0.9500473017990948], 
             Alignment -> {Left, Baseline}], 
            Item[
             Pane[
              Annotation[
               EventHandler[
                MouseAppearance[
                 Mouseover["LocationID", 
                  Style[
                  "LocationID", FontColor -> 
                   RGBColor[
                    0.2749633796890805, 0.536987306253161, 
                    0.791992189065661]]], "LinkHand"], {"MouseClicked", 1} :> 
                If[
                  TypeSystem`NestedGrid`PackagePrivate`checkInteractivity[
                  TypeSystem`NestedGrid`PackagePrivate`$state$$], 
                  TypeSystem`NestedGrid`PackagePrivate`updateState[
                  TypeSystem`NestedGrid`PackagePrivate`$state$$, 
                   TypeSystem`NestedGrid`PackagePrivate`$path$$, 
