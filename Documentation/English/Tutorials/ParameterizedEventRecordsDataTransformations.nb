Cell[CellGroupData[{

Cell["Making contingency matrices", "Subsection",
 CellChangeTimes->{{3.7472348170811253`*^9, 3.7472348231773376`*^9}},
 CellID->197279872,ExpressionUUID->"7dc85c60-1cee-45b0-af50-99de478a176c"],

Cell["\<\
One of the main goals of ERTMon is to produce contingency matrices \
corresponding to the event records data.\
\>", "Text",
 CellChangeTimes->{{3.747587824744812*^9, 3.747587863765518*^9}, 
   3.7475990224695*^9},
 CellID->2115541383,ExpressionUUID->"3178431c-d985-48fc-9c12-29ef5d35d769"],

Cell[CellGroupData[{

Cell[TextData[{
 "The contingency matrices are created and stored as ",
 StyleBox["SSparseMatrix", "Program"],
 " objects, [AAp7]."
}], "Text",
 CellChangeTimes->{{3.7473510332374067`*^9, 3.747351082027474*^9}, {
  3.7473526940135193`*^9, 3.747352697556378*^9}, {3.747588060549768*^9, 
  3.747588067067664*^9}},
 CellID->17280702,ExpressionUUID->"48773e1d-b53b-48d7-bf0e-00f938ec341e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p", "=", "\[IndentingNewLine]", 
   RowBox[{
   "p", "\[DoubleLongRightArrow]", "ERTMonMakeContingencyMatrices"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.7475880699245996`*^9, 3.747588075837082*^9}},
 CellLabel->"In[116]:=",
 CellID->526466169,ExpressionUUID->"2aa267ee-25a3-4ccd-9e44-0fb173530534"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
We can obtain an association of the contingency matrices for each \
variable-and-aggregation-function pair, or obtain the overall contingency \
matrix.\
\>", "Text",
 CellChangeTimes->{{3.747587890997896*^9, 3.747587994570059*^9}, {
  3.7475990639354*^9, 3.747599079370656*^9}},
