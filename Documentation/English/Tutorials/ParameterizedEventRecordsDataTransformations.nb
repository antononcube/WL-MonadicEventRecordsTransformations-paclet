 CellID->672789423,ExpressionUUID->"bb585ac5-357e-49a4-b167-be59ad80263b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Grouping event records by entity-variable pairs", "Subsection",
 CellChangeTimes->{{3.747234854632372*^9, 3.747234872621634*^9}},
 CellID->1070430906,ExpressionUUID->"f5577fb5-a2bc-4210-a7fc-38a99473edf7"],

Cell[CellGroupData[{

Cell["\<\
With the function ERTMonGroupEntityVariableRecords we group the event records \
by the found unique entity-variable pairs. Note that in the pipeline below we \
set the computation specification first.\
\>", "Text",
 CellChangeTimes->{{3.747564407931926*^9, 3.747564416760373*^9}, {
  3.747564471387939*^9, 3.747564540652658*^9}},
 CellID->1261726223,ExpressionUUID->"2b226b5f-1d50-44da-a93c-08d72783d501"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p", "=", "\[IndentingNewLine]", 
   RowBox[{"p", "\[DoubleLongRightArrow]", "\[IndentingNewLine]", 
    RowBox[{"ERTMonSetComputationSpecification", "[", "wCompSpec", "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", "ERTMonGroupEntityVariableRecords"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.747563863665407*^9, 3.747563886391507*^9}, 
   3.747564119833996*^9, {3.747564341200777*^9, 3.7475643876057673`*^9}},
 CellLabel->"In[103]:=",
 CellID->1579099483,ExpressionUUID->"064a5d04-8531-4a19-8f9b-82e2cb37bec0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Descriptive statistics (per variable)", "Subsection",
 CellChangeTimes->{{3.747234844068342*^9, 3.747234852291791*^9}, {
  3.7472348832078123`*^9, 3.747234887449252*^9}},
 CellID->1322101155,ExpressionUUID->"7b8b00d6-0421-429c-9d7c-0d83862c499e"],

Cell[CellGroupData[{

Cell[TextData[{
 "After the data is ingested into the monad and the event records are grouped \
per entity-variable pairs we can find certain descriptive statistics for the \
data. This is done with the general function ",
 StyleBox["ERTMonComputeVariableStatistic", "Program"],
 " and the specialized function  ",
 StyleBox["ERTMonFindVariableOutlierBoundaries", "Program"],
 "."
}], "Text",
 CellChangeTimes->{{3.747563794174088*^9, 3.7475638032862787`*^9}, {
