Cell[CellGroupData[{

Cell["Example", "Subsection",
 CellChangeTimes->{{3.7471473435745373`*^9, 3.747147348354989*^9}},
 CellID->907647794,ExpressionUUID->"c435447e-fcc8-4803-bd69-12d7e14ed8e1"],

Cell[CellGroupData[{

Cell["For example, here we take all weather stations in USA:", "Text",
 CellChangeTimes->{{3.747146285735819*^9, 3.747146296535989*^9}, {
  3.747146375939074*^9, 3.7471464267563477`*^9}, {3.747146578096471*^9, 
  3.747146578823888*^9}, {3.747146620066834*^9, 3.747146622485664*^9}},
 CellID->1260129117,ExpressionUUID->"d1be414b-7ec4-4556-98a9-69b396f34d80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ws", "=", 
  RowBox[{"Normal", "[", 
   RowBox[{"entityAttributes", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#Attribute", "\[Equal]", "\"\<Country\>\""}], "&&", 
        RowBox[{"#Value", "==", "\"\<USA\>\""}]}], "&"}], "]"}], 
     ",", "\"\<EntityID\>\""}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.747146483136985*^9, 3.747146568397047*^9}, {
  3.747146638102413*^9, 3.7471466442551327`*^9}},
 CellLabel->"In[29]:=",
 CellID->506342705,ExpressionUUID->"ca09dc42-360a-48a1-b94b-3a94f90a3353"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Miami_USA\"\>", ",", "\<\"Jacksonville_USA\"\>", 
   ",", "\<\"Chicago_USA\"\>"}], "}"}]], "Output",
 CellChangeTimes->{3.747605996661922*^9, 3.970481205912725*^9},
 CellLabel->"Out[29]=",
 CellID->621342287,ExpressionUUID->"8db5a9a3-245e-41f8-8cfd-5a5d6dbf7fe3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Here we take all temperature event records for those weather stations:\
\>", "Text",
 CellChangeTimes->{{3.747146585213808*^9, 3.7471466310245123`*^9}, 
   3.7473526530987387`*^9},
 CellID->983821792,ExpressionUUID->"a9886191-c17c-4345-aa95-0e7ac3ad4f11"],

Cell[BoxData[
 RowBox[{
  RowBox[{"srecs", "=", 
   RowBox[{"eventRecords", "[", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#Variable", "\[Equal]", "\"\<Temperature\>\""}], "&&", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"ws", ",", "#EntityID"}], "]"}]}], "&"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.747146427938943*^9, 3.7471464724318743`*^9}, {
  3.747146634591147*^9, 3.747146695152359*^9}, {3.747146736631509*^9, 
  3.7471467553162117`*^9}, {3.747147143020939*^9, 3.747147166947111*^9}},
 CellLabel->"In[30]:=",
 CellID->1616259891,ExpressionUUID->"c4ee32ce-2544-4e29-9bad-dfe35918bf99"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
And here plot the corresponding time series obtained by grouping the records \
by station (entity ID\[CloseCurlyQuote]s) and taking the columns \
\[OpenCurlyDoubleQuote]ObservationTime\[CloseCurlyDoubleQuote] and \
\[CloseCurlyDoubleQuote]Value\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.7471467005501823`*^9, 3.747146710926263*^9}, {
  3.747146966156023*^9, 3.747147050181869*^9}, {3.747352654928679*^9, 
  3.747352655344996*^9}},
 CellID->959337134,ExpressionUUID->"c6e445d3-98ef-4b5e-a977-46e637686462"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grecs", "=", 
   RowBox[{"Normal", "@", 
    RowBox[{
     RowBox[{"GroupBy", "[", 
      RowBox[{"srecs", ",", 
       RowBox[{"#EntityID", "&"}]}], "]"}], "[", 
     RowBox[{"All", ",", "All", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<ObservationTime\>\"", ",", "\"\<Value\>\""}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"DateListPlot", "[", 
  RowBox[{"grecs", ",", 
   RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.747146748746331*^9, 3.747146761246825*^9}, {
   3.747146818164315*^9, 3.747146846647756*^9}, 3.7471469620387163`*^9, {
